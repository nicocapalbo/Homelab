# User / System
PUID=1000
PGID=1000
TZ="Europe/Madrid"
DOCKERDIR="/home/nico/docker"
APPDIR="/home/nico/docker/appdata"
SERVER_IP=your-server-lan-ip

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_TUNNEL_ID=your-cloudflare-tunnel-id
CLOUDFLARE_TUNNEL_READ_TOKEN=your-cloudflare-tunnel-read-token

# Media
PLEX_TOKEN=your-plex-token
TAUTULLI_KEY=your-tautulli-api-key
OVERSEERR_API=your-overseerr-api-key
RD_API_KEY=your-real-debrid-api-key
RIVEN_API_KEY=your-riven-api-key

# Management
PORTAINER_KEY=your-portainer-key
NGINX_PASSWORD=your-nginx-password
NPM_USERNAME=your-npm-username
HOMEPAGE_ALLOWED_HOSTS=your-homepage-hostname

# DUMB Services
SONARR_API_KEY=your-sonarr-api-key
RADARR_API_KEY=your-radarr-api-key
PROWLARR_API_KEY=your-prowlarr-api-key
SEERR_API_KEY=your-seerr-api-key
SONARR4K_API_KEY=your-sonarr4k-api-key
RADARR4K_API_KEY=your-radarr4k-api-key

# Home Assistant
HOMEASSISTANT_TOKEN=your-home-assistant-long-lived-token

# Paperless-ngx
PAPERLESSNGX_TOKEN=your-paperless-token

# Speedtest Tracker
#SPEEDTESTTRACKER_KEY=base64:placeholder
SPEEDTESTTRACKER_KEY=base64:your-speedtest-tracker-key
SPEEDTESTTRACKER_API=your-speedtest-tracker-api-key

# Pi-hole
PIHOLE_PASSWORD=your-pihole-password

# Beszel
BESZEL_USERNAME=your-beszel-username
BESZEL_SUPERUSER_PASSWORD=your-beszel-password
BESZEL_AGENT_TOKEN=your-beszel-agent-token

# Paperless-ngx
PAPERLESS_DB_PASSWORD=your-paperless-db-password
PAPERLESS_SECRET_KEY=your-paperless-secret-key

# Discord
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# Firefly III
STATIC_CRON_TOKEN=your-32-char-static-cron-token
MYSQL_USER=firefly
MYSQL_PASSWORD=your-firefly-db-password
MYSQL_DATABASE=firefly

# WhatsApp Playtomic Importer
WHATSAPP_ALLOWED_CHAT_IDS=your-whatsapp-allowed-chat-ids
PLAYTOMICDB_BASE_URL=your-playtomicdb-base-url
PLAYTOMICDB_ADMIN_TOKEN=your-playtomicdb-admin-token
